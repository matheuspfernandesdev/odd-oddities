# OpenRouter API
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Models
TEXT_MODEL_ID=google/gemma-4-26b-a4b-it:free
IMAGE_MODEL_ID=openai/gpt-image-2

# Video / Reels (aliases consumed by docker-compose.yml, which maps them to
# AppConfiguration__Video__* and AppConfiguration__ModelSelection__MaxCostPerVideoRunUsd)
VIDEO_MODEL_ID=bytedance/seedance-2.0-mini
VIDEO_DURATION_SECONDS=5
VIDEO_RESOLUTION=480p
VIDEO_ASPECT_RATIO=9:16
VIDEO_GENERATE_AUDIO=true
VIDEO_INTERVAL_DAYS=15
MAX_VIDEO_COST_PER_RUN_USD=0.20

# Comments (aliases consumed by docker-compose.yml, which maps them to
# AppConfiguration__Comments__*). Keep disabled until the Instagram token carries
# the manage_comments permission (RF-19/RF-22).
COMMENTS_ENABLED=false
COMMENTS_LOOKBACK_POSTS=15

# Meta (Instagram) Configuration
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_ACCESS_TOKEN=your_meta_access_token_here
INSTAGRAM_USER_ID=your_instagram_user_id_here

# PostgreSQL Configuration
POSTGRES_DB=odd_oddities
POSTGRES_USER=odd_oddities
POSTGRES_PASSWORD=your_postgres_password_here

# MinIO Configuration
MINIO_ACCESS_KEY=your_minio_access_key_here
MINIO_SECRET_KEY=your_minio_secret_key_here
MINIO_BUCKET_NAME=odd-oddities-dev

# Token Encryption (AES-256-GCM key, 32 characters)
TOKEN_ENCRYPTION_KEY=your_32_char_encryption_key_here

# Schedule Configuration
SCHEDULE_HOUR_UTC=17
SCHEDULE_TIMEZONE=Eastern Standard Time
SCHEDULE_DAYS=TUE,THU,SAT

# Storage Domain (for public access - shared MinIO instance)
STORAGE_DOMAIN=s3.binaryten.com.br
